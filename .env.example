# Upstream 9router (tanpa auth, hanya dengar di localhost)
UPSTREAM=http://127.0.0.1:20128
# Login dashboard: username + password (isi keduanya di .env)
ADMIN_USER=admin
ADMIN_PASS=ganti-dengan-password-kuat
# Kunci admin untuk kelola share key via API (header x-admin-key).
# Kalau dikosongkan, API hanya bisa diakses setelah login (cookie session).
ADMIN_KEY=ganti-dengan-kunci-acak-panjang
# Opsional: sk- key 9router. KOSONGKAN SAJA — RouterX otomatis memakai
# token CLI lokal (x-9r-cli-token), setara auth CLI 9router sendiri.
UPSTREAM_KEY=
# Port dijalankan via script (dev default 3001, start default 20228)
PORT=20228
